rules_version = '2';
// Solo los correos de esta lista pueden leer y guardar datos del taller.
// Agrega o quita correos y vuelve a publicar las reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          "richar.1504@gmail.com",
          "trabajador1@ejemplo.com"
        ];
    }
  }
}
